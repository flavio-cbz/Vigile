# Vigile — Master Node
# Dockerfile for the Python/FastAPI backend

# ── Stage 1: Build the frontend React SPA ────────────────────────────────
FROM node:22-alpine AS frontend-builder
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# ── Stage 1b: Build static worker binaries for local distribution ─────────
FROM golang:1.23-alpine AS worker-builder
WORKDIR /worker
COPY worker/ ./
ARG WORKER_VERSION=1.2.0
RUN mkdir -p /releases && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w -X main.Version=${WORKER_VERSION}" -o /releases/worker-linux-amd64 . && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -ldflags="-s -w -X main.Version=${WORKER_VERSION}" -o /releases/worker-linux-arm64 . && \
    cd /releases && \
    sha256sum worker-linux-amd64 > worker-linux-amd64.sha256 && \
    sha256sum worker-linux-arm64 > worker-linux-arm64.sha256

# ── Stage 2: Backend & Runtime ───────────────────────────────────────────
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONPATH=/app

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    minisign \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy all project files (ignoring those in .dockerignore)
COPY . .

# Overwrite master/static with the compiled frontend files from stage 1
COPY --from=frontend-builder /frontend/dist/ ./master/static/

# Copy compiled worker releases for local/offline distribution
COPY --from=worker-builder /releases/ ./master/static/releases/

# Create data directory for DB and keys
RUN mkdir -p /app/data

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -s http://localhost:8000/health | grep -q '"status":"ok"' || exit 1

# Run with uvicorn
CMD ["uvicorn", "master.main:app", "--host", "0.0.0.0", "--port", "8000"]
