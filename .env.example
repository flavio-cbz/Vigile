# Vigile — Environment Variables
# Copy this file to .env and adjust values for your deployment.

## Server
MASTER_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000
DEBUG=false

## Database
DATABASE_PATH=./data/vigile.db

## Security — HMAC & JWT secrets
# Auto-generated if empty (dev only — SET for production!)
SERVER_SECRET_KEY=
JWT_SECRET_KEY=

## JWT lifecycle (seconds)
JWT_ACCESS_TOKEN_TTL=3600        # 1 hour
JWT_REFRESH_TOKEN_TTL=86400      # 24 hours

## Enrollment
JOIN_TOKEN_TTL=1800              # 30 minutes
WORKER_TOKEN_TTL=2592000         # 30 days
WORKER_TOKEN_ROTATION=604800     # 7 days

## Node Monitoring (seconds)
HEARTBEAT_INTERVAL=30
HEARTBEAT_LOST_THRESHOLD=300     # 5 minutes
HEARTBEAT_STALE_THRESHOLD=86400  # 24 hours

## Master Ed25519 keypair path
MASTER_KEY_PATH=./data/master_ed25519.key

## HTTPS enforcement (behind reverse proxy, checks X-Forwarded-Proto)
ENFORCE_HTTPS=false

## Browser session cookies
# Set COOKIE_SECURE=true when served through HTTPS by a reverse proxy.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

## LLM provider (OpenAI-compatible endpoint)
# Leave empty to disable the chat endpoint
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

## CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

## Plugins directory
PLUGINS_DIR=./master/plugins

## Trusted proxies for X-Forwarded-For (comma-separated IPs, empty = disabled)
TRUSTED_PROXIES=
