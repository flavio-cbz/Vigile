# EditorConfig — Vigile Project
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.go]
indent_style = tab
indent_size = 8

[{Makefile,Dockerfile,Dockerfile.*}]
indent_style = tab
indent_size = 4

[*.{ts,tsx,js,jsx,css}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100
