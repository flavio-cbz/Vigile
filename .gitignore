# Vigile — .gitignore
# Version-controlled ignore patterns

## Python — Runtime & Build
__pycache__/
*.py[cod]
*.egg-info/
*.egg
*.so
dist/
build/
.eggs/
*.whl

## Python — Virtual Environment
.venv/
venv/
env/
env.bak/
venv.bak/

## Python — Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.mypy_incremental/
.ruff_cache/
*.cover

## Environment & Configuration
.env
.env.*
!.env.example
.env.local
.env.*.local

## Database
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

## Cryptographic keys (NEVER commit these!)
*.key
*.pem
*.p12
data/

## Go Build
worker/vigile-worker
worker/worker
*.o
*.a

## OS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini

## IDE & Editors
.vscode/
.cursor/
.idea/
*.swp
*.swo
*~
.project
.classpath
.antigravity/
.omo/

## Logs
*.log
*.log.*

## Temp & Build Artifacts
/tmp/
/temp/
*.tmp
.pytest_tmp/

## Docker Build Artifacts
.dockerignore
.docker/

## Documentation & Rules (local only)
RULES.md
AGENTS.md

## Tool-specific Artifacts
.slim/
.sisyphus/
.playwright-mcp/
.browserstack-local/
.agents/
scratch/
interview/
opencode.json

## Local development artifacts
.codegraph/
.vite/

## Local screenshots (debug/visual QA)
light-*.png
*.tmp.png

## Worker build cache
worker-cache/
